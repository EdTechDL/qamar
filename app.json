{
  "expo": {
    "name": "Qamar",
    "slug": "qamar",
    "version": "0.0.1",
    "orientation": "default",
    "scheme": "qamar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.qamar.hifz",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "requireFullScreen": false
    },
    "android": {
      "package": "app.qamar.hifz",
      "adaptiveIcon": {
        "backgroundColor": "#F5EAC7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "fr",
      "themeColor": "#F5EAC7",
      "description": "Application hors-ligne de mémorisation du Coran, pensée pour les profils TDAH."
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-av",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
